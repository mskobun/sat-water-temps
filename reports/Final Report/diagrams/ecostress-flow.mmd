%% ECOSTRESS Updater — internal logic.
%% Three stages: trigger, initiator fan-out, per-scene processing.
%% No Step Function, no polling layer.
flowchart TB
  classDef trig fill:#eef9ee,stroke:#2b7a2b,stroke-width:1px,color:#222;
  classDef init fill:#fff5e6,stroke:#b86b00,stroke-width:1px,color:#222;
  classDef proc fill:#e6f0ff,stroke:#1a56cc,stroke-width:1px,color:#222;
  classDef store fill:#f7e8ff,stroke:#6a1b9a,stroke-width:1px,color:#222;
  classDef ext fill:#f0f0f0,stroke:#555,stroke-width:1px,color:#222;

  subgraph S1["Stage 1 — Trigger"]
    cw["CloudWatch schedule<br/>(daily, cron)"]:::trig
    fu["Function URL<br/>(/admin/requests)"]:::trig
  end

  subgraph S2["Stage 2 — Initiator"]
    direction TB
    init["ECOSTRESS Initiator<br/>Lambda"]:::init
    stac["CMR-STAC search<br/>(earthaccess)"]:::ext
    req["Insert data_requests row<br/>(source=ecostress, task_id)"]:::store
    fanout["Fan out one SQS message<br/>per (AID, scene date)"]:::init

    init --> stac
    stac --> init
    init --> req
    init --> fanout
  end

  subgraph S3["Stage 3 — Processor (per message)"]
    direction TB
    open["Open COG tiles via HTTPS<br/>(rasterio range reads)"]:::proc
    merge["Mosaic tiles + majority-CRS<br/>select + clip to polygon"]:::proc
    filt["Six-stage filter stack<br/>(bits 0..5)"]:::proc
    write["Write outputs"]:::proc
    r2[("R2<br/>CSV.gz + TIF + PNG + Parquet")]:::store
    d1[("D1<br/>temperature_metadata +<br/>processing_jobs.filter_stats")]:::store

    open --> merge --> filt --> write
    write --> r2
    write --> d1
  end

  cw --> init
  fu --> init
  fanout -->|SQS message| open
