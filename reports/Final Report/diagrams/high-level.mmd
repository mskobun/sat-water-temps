%% High-Level System Architecture
%% Two zones: AWS (ingestion) and Cloudflare (serving).
flowchart LR
  classDef aws fill:#fff5e6,stroke:#b86b00,stroke-width:1px,color:#222;
  classDef cf  fill:#e6f0ff,stroke:#1a56cc,stroke-width:1px,color:#222;
  classDef ext fill:#f0f0f0,stroke:#555,stroke-width:1px,color:#222;
  classDef usr fill:#eef9ee,stroke:#2b7a2b,stroke-width:1px,color:#222;

  subgraph AWS["AWS ingestion zone"]
    direction TB
    cw["CloudWatch Event Rules<br/>(daily schedule)"]
    ei["ECOSTRESS Initiator<br/>Lambda"]
    li["Landsat Initiator<br/>Lambda"]
    sqs["SQS queue<br/>(processing)"]
    proc["Processor Lambda<br/>(50x concurrency cap)"]

    cw --> ei
    cw --> li
    ei --> sqs
    li --> sqs
    sqs --> proc
  end

  subgraph CAT["NASA data catalogues"]
    direction TB
    cmr["CMR-STAC<br/>(ECOSTRESS L2T)"]
    usgs["USGS STAC<br/>(Landsat C2 L2)"]
  end

  subgraph CF["Cloudflare serving zone"]
    direction TB
    pages["Cloudflare Pages<br/>(SvelteKit edge routes)"]
    d1["D1 database<br/>(metadata, jobs, requests)"]
    r2["R2 bucket<br/>(CSV, PNG, TIF, Parquet)"]

    pages --- d1
    pages --- r2
  end

  user(["Researcher browser"]):::usr
  admin(["Administrator"]):::usr

  ei -.-> cmr
  li -.-> usgs
  proc --> r2
  proc --> d1

  user --> pages
  admin --> pages
  pages -. on-demand backfill .-> ei
  pages -. on-demand backfill .-> li

  class cw,ei,li,sqs,proc aws;
  class pages,d1,r2 cf;
  class cmr,usgs ext;
