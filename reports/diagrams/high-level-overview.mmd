flowchart TB
  subgraph users["Users"]
    admin(["Administrator"])
    researcher(["Researcher browser"])
  end

  subgraph cf["Cloudflare serving zone"]
    pages["Cloudflare Pages\n(SvelteKit app + API)"]
    d1[("D1 database\nmetadata, jobs,\nrequests, settings")]
    r2[("R2 bucket\nPNG, TIF, Parquet")]
  end

  subgraph aws["AWS ingestion zone (us-west-2)"]
